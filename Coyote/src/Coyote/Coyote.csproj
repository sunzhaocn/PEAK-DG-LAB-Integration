<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Coyote</AssemblyName>
    <AssemblyTitle>Coyote</AssemblyTitle>
    <!-- BepInEx plugin version; intentionally independent of the desktop APP_VERSION. -->
    <Version>0.1.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Portable/local builds do not need Thunderstore metadata. Maintainers
         can opt in with -p:IsThunderstorePackable=true after configuring
         ThunderstoreTeam in Config.Build.user.props. -->
    <IsThunderstorePackable>false</IsThunderstorePackable>
    <ThunderstoreName>Coyote</ThunderstoreName>
    <ThunderstoreDescription>PEAK telemetry plugin for the Coyote DG-LAB integration desktop application.</ThunderstoreDescription>
    <ThunderstoreCommunities>peak</ThunderstoreCommunities>
    <ThunderstoreCategories>mods</ThunderstoreCategories>
  </PropertyGroup>

  <!-- CI can supply a declaration-only PEAK API reference assembly without
       committing proprietary game binaries. Local builds continue to use the
       real PEAK Managed directory through Directory.Build.targets. -->
  <ItemGroup Condition="'$(PEAK_REFERENCE_ASSEMBLY)' != '' And Exists('$(PEAK_REFERENCE_ASSEMBLY)')">
    <Reference Include="Assembly-CSharp" HintPath="$(PEAK_REFERENCE_ASSEMBLY)" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <ModFile Include="$(TargetPath)" Destination="plugins/" />
  </ItemGroup>

  <ItemGroup>
    <ThunderstorePackageFile Include="$(SolutionRoot)README.md" />
    <ThunderstorePackageFile Include="$(SolutionRoot)CHANGELOG.md" />
    <ThunderstorePackageFile Include="$(SolutionRoot)icon.png" />
    <ThunderstorePackageFile Include="$(SolutionRoot)LICENSE" />
    <ThunderstoreDependency Include="BepInEx-BepInExPack_PEAK" Version="5.4.75301" />
  </ItemGroup>
</Project>
